# Use npm run setup to generate private database credentials and start an isolated DB.
# Fixed local demo account logins are documented in README.md and SETUP_AND_RUN.txt.
# For an existing PostgreSQL server, copy this file to .env and replace placeholders.
DATABASE_URL=postgresql://reserveflow_app:CHANGE_ME@localhost:54329/reserveflow
MIGRATION_DATABASE_URL=postgresql://reserveflow_owner:CHANGE_ME@localhost:54329/reserveflow
TEST_DATABASE_URL=postgresql://reserveflow_owner:CHANGE_ME@localhost:54329/reserveflow_test
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Optional: full directory containing initdb, pg_ctl and postgres binaries.
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
LOCAL_POSTGRES=true
# Private values used only by the isolated local setup helper:
LOCAL_DB_OWNER_PASSWORD=CHANGE_ME
LOCAL_DB_APP_PASSWORD=CHANGE_ME
