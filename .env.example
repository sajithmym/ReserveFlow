# Database Configuration (PostgreSQL)
# postgres is supported for local development. Production requires a restricted role.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_DATABASE=reserveflow
# Remote servers require certificate verification:
# DB_SSL_MODE=verify-full
# Optional migration/maintenance identity (defaults to the DB_* settings):
# MIGRATION_DB_USERNAME=reserveflow_owner
# MIGRATION_DB_PASSWORD=CHANGE_ME
# Isolated tests require their own explicit non-elevated identity and database:
# These TEST_DB_* fields may be placed in an ignored .env.test.local file.
# TEST_DB_USERNAME=reserveflow_test_owner
# TEST_DB_PASSWORD=CHANGE_ME
# TEST_DB_DATABASE=reserveflow_test
# TEST_DB_HOST and TEST_DB_PORT default to DB_HOST and DB_PORT.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_KEY
LOCAL_POSTGRES=false
# Leave unset locally. Only use a header your reverse proxy overwrites, and keep
# the application origin inaccessible to direct clients when enabling it.
# AUTH_TRUSTED_IP_HEADER=x-real-ip
# Set these only long enough to run npm run db:bootstrap-admin, then remove them.
ADMIN_BOOTSTRAP_EMAIL=admin@example.local
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_PRIVATE_12_PLUS_CHARACTER_PASSWORD
